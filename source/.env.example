# Copy to .env and put your real key in API_KEY. Never commit or submit .env.
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.5-flash-lite
API_KEY=your-api-key-here

# Optional: another PERMITTED model of the same provider, used only if MODEL_NAME returns "not found".
FALLBACK_MODEL_NAME=gemini-3.1-flash-lite

# Optional tuning (defaults shown). LLM_MIN_INTERVAL keeps us under the free tier's 15 requests/min.
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_MIN_INTERVAL=4.5
LLM_TEMPERATURE=

# Optional: full path to tesseract.exe if it is not on PATH (Windows). Leave empty otherwise.
TESSERACT_CMD=
